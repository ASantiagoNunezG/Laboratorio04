<Window x:Class="Laboratorio04.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Laboratorio04"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        
        <StackPanel>
            <Button Content="Siguiente" Click="BtnSiguiente_Click" Width="100" Margin="2"/>
            <Button Content="Cargar Productos" Width="150" Margin="0,0,0,10" Click="BtnCargar_Click"/>
            <DataGrid x:Name="dgProductos" AutoGenerateColumns="True" Height="350"/>
        </StackPanel>
    </Grid>
</Window>
