<Window x:Class="Laboratorio04.Laboratorio3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Laboratorio04"
        mc:Ignorable="d"
        Title="Laboratorio3" Height="450" Width="800">
    <Grid Margin="10">
        
        <StackPanel>
            <Button Content="Atrás" Click="BtnAtras_Click" Width="100" Margin="2"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Label Content="Desde:" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpDesde" Margin="5,0"/>
                <Label Content="Hasta:" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpHasta" Margin="5,0"/>
                <Button Content="Buscar" Width="100" Click="Buscar_Click"/>
            </StackPanel>

            <DataGrid x:Name="dgResultados" AutoGenerateColumns="True" Height="400"/>
        </StackPanel>
    </Grid>
</Window>
