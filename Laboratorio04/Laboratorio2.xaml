<Window x:Class="Laboratorio04.Laboratorio2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Laboratorio04"
        mc:Ignorable="d"
        Title="Laboratorio2" Height="450" Width="800">
    <Grid Margin="10">
        
        <StackPanel>
            <Button Content="Atrás" Click="BtnAtras_Click" Margin="2" Width="100"/>
            <Button Content="Siguiente" Click="BtnSiguiente_Click" Margin="2" Width="100"/>
            <Button Content="Cargar Categorías" Width="150" Margin="0,0,0,10" Click="BtnCargarCategorias_Click"/>
            <DataGrid x:Name="dgCategorias" AutoGenerateColumns="True" Height="300"/>
        </StackPanel>
    </Grid>
</Window>
